# Copy this file to .env.local for local development.
# On Vercel, add these under Project Settings -> Environment Variables instead.

# Base64-encoded contents of your GA4 service account JSON key.
# Create with: base64 -i service-account-key.json | tr -d '\n'
GA4_SERVICE_ACCOUNT_KEY=

# Your GA4 property's numeric ID (GA Admin -> Property Settings)
GA4_PROPERTY_ID=

# Search Console site, exactly as it appears in Search Console.
# Domain properties: "sc-domain:example.com"
# URL-prefix properties: "https://www.example.com/"
SEARCH_CONSOLE_SITE_URL=
